  },
  {
    "id": "waiver-rule-b",
    "type": "rule",
    "label": "Rule B",
    "waives": [
      "bed-fully-electric-upgrade",
      "bed-hi-lo-upgrade"
    ],
    "trigger": "Full Medicaid or a Medicaid MCO in a state where UMS is enrolled. Medicaid is billed as primary for the bed.",
    "exception": "Medicaid from a non-enrolled state and QMB-only status do not qualify. Rule B includes Rule A.",
    "authority": "Billing & Insurance v2.0 §16",
    "includes": [
