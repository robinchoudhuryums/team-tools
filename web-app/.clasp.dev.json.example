{
  "//": "Copy this file to web-app/.clasp.dev.json (gitignored) and paste your SEPARATE dev Apps Script project's scriptId below. `npm run push:dev` swaps this over .clasp.json, pushes, then restores prod. See docs/deployment.md. Keep filePushOrder EQUAL to the prod .clasp.json: it declares which files are the server source and in what load order, and Batch F1 made the test harness derive that from it.",
  "scriptId": "PASTE_YOUR_DEV_SCRIPT_ID_HERE",
  "rootDir": ".",
  "scriptExtensions": [
    ".js",
    ".gs"
  ],
  "htmlExtensions": [
    ".html"
  ],
  "jsonExtensions": [
    ".json"
  ],
  "filePushOrder": [
    "00_config.js",
    "10_core.js",
    "20_timeclock.js",
    "30_callnotes.js",
    "40_metrics.js",
    "50_deptrequests.js",
    "51_spanish.js",
    "60_intake.js",
    "61_forms.js",
    "70_kb.js",
    "80_training.js",
    "81_empdocs.js",
    "82_coaching.js",
    "90_qa.js"
  ],
  "skipSubdirectories": false
}
